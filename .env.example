# CIRIS Phase 2 Productization Environment Variables

# Database Connection (PostgreSQL + PostGIS)
# Fallback: sqlite:///./ciris_prototype.db if PostgreSQL is not active
DATABASE_URL=postgresql://ciris_user:ciris_password@localhost:5432/ciris_db

# CORS Allowed Origins (Comma-separated)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173

# Application Settings
ENVIRONMENT=development
LOG_LEVEL=INFO
MODEL_DIR=models_serialized
